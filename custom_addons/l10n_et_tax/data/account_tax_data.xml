        </record>

        <!-- ============================================== -->
        <!-- PURCHASE TAXES (የግዢ ታክሶች)                      -->
        <!-- ============================================== -->

        <!-- Standard VAT 15% Purchases -->
        <record id="et_tax_purchase_vat_15" model="account.tax">
            <field name="name">VAT 15% (Purchases)</field>
            <field name="description">VAT 15%</field>
            <field name="type_tax_use">purchase</field>
            <field name="amount_type">percent</field>
            <field name="amount">15.0</field>
            <field name="country_id" ref="base.et"/>
            <field name="tax_group_id" ref="l10n_et.tax_group_vat_15"/>
        </record>

        <!-- Zero-Rated VAT 0% Purchases -->
        <record id="et_tax_purchase_vat_0" model="account.tax">
            <field name="name">VAT 0% (Purchases)</field>
            <field name="description">VAT 0%</field>
            <field name="type_tax_use">purchase</field>
            <field name="amount_type">percent</field>
