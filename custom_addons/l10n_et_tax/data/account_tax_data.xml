            <field name="name">TOT 10% (Purchases - Services)</field>
            <field name="description">TOT 10%</field>
            <field name="type_tax_use">purchase</field>
            <field name="amount_type">percent</field>
            <field name="amount">10.0</field>
            <field name="is_tot_tax">True</field>
            <field name="country_id" ref="base.et"/>
            <field name="tax_group_id" ref="l10n_et_tax.tax_group_tot_10"/>
        </record>

        <!-- Withholding Tax 2% Purchases -->
        <record id="et_tax_purchase_wht_2" model="account.tax">
            <field name="name">Withholding Tax 2% (Purchases)</field>
            <field name="description">WHT 2%</field>
            <field name="type_tax_use">purchase</field>
            <field name="amount_type">percent</field>
            <field name="amount">-2.0</field>
            <field name="is_wht_tax">True</field>
            <field name="country_id" ref="base.et"/>
            <field name="tax_group_id" ref="l10n_et.tax_group_withh_2"/>
        </record>
    </data>
</odoo>
