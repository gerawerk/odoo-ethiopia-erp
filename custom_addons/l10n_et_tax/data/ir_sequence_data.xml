<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence for Ethiopian Ministry of Revenues Withholding Tax Certificate / Receipt -->
    <record id="seq_l10n_et_wht_receipt" model="ir.sequence">
        <field name="name">Ethiopian Withholding Tax Receipt Sequence</field>
        <field name="code">l10n_et_tax.wht.receipt</field>
        <field name="prefix">WHT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
