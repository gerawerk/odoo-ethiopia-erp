<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb PDF Report Action for Ministry of Revenues Withholding Tax Receipt -->
    <record id="action_report_wht_receipt" model="ir.actions.report">
        <field name="name">Withholding Tax Receipt (የተቀናሽ ታክስ ደረሰኝ)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_et_tax.report_wht_receipt</field>
        <field name="report_file">l10n_et_tax.report_wht_receipt</field>
        <field name="print_report_name">(object.wht_receipt_number or 'WHT_Receipt').replace('/', '_')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Main Report Template -->
    <template id="report_wht_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_et_tax.report_wht_receipt_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- Document Layout Template -->
    <template id="report_wht_receipt_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 12px; color: #111827;">
                <!-- Official Ministry Header -->
                <div class="text-center mb-3">
                    <h5 class="mb-0 fw-bold" style="letter-spacing: 0.5px;">THE FEDERAL DEMOCRATIC REPUBLIC OF ETHIOPIA</h5>
                    <h5 class="mb-1 fw-bold" style="color: #1f2937;">የኢትዮጵያ ፌዴራላዊ ዲሞክራሲያዊ ሪፐብሊክ</h5>
                    <h6 class="mb-2 text-muted fw-bold">MINISTRY OF REVENUES / የገቢዎች ሚኒስቴር</h6>
                    <div style="display: inline-block; border: 2px solid #1f2937; padding: 6px 24px; background-color: #f3f4f6; border-radius: 4px;">
                        <span style="font-size: 15px; font-weight: bold; letter-spacing: 1px;">WITHHOLDING TAX RECEIPT / የተቀናሽ ግብር ደረሰኝ</span>
                    </div>
                </div>

                <!-- Top Two-Column Block: Issuer & Receipt Info -->
                <div class="row mb-3">
                    <!-- Left: Withholding Agent (Company) -->
                    <div class="col-7">
                        <div class="p-2 border rounded" style="background-color: #fafafa; min-height: 120px;">
                            <div class="fw-bold text-uppercase border-bottom pb-1 mb-1" style="font-size: 11px; color: #374151;">
                                Withholding Agent Details (የተቀናሽ ግብር ሰብሳቢ / ወኪል)
                            </div>
                            <div><strong>Organization:</strong> <span t-field="o.company_id.name"/></div>
                            <div><strong>TIN (የግብር ከፋይ መለያ):</strong> <span class="font-monospace fw-bold" t-esc="o.company_id.et_tin_number or o.company_id.vat or 'N/A'"/></div>
                            <div t-if="o.company_id.et_vat_reg_number">
                                <strong>VAT Reg. No (የተጨማሪ እሴት ታክስ ምዝገባ):</strong> <span t-field="o.company_id.et_vat_reg_number"/>
                            </div>
                            <div>
                                <strong>Address:</strong>
                                <span t-if="o.company_id.et_sub_city">Sub-City: <span t-field="o.company_id.et_sub_city"/>, </span>
                                <span t-if="o.company_id.et_woreda">Woreda: <span t-field="o.company_id.et_woreda"/>, </span>
                                <span t-if="o.company_id.et_house_number">House No: <span t-field="o.company_id.et_house_number"/>, </span>
                                <span t-field="o.company_id.city"/>
                            </div>
                            <div t-if="o.company_id.phone"><strong>Phone:</strong> <span t-field="o.company_id.phone"/></div>
                        </div>
                    </div>

                    <!-- Right: Receipt Reference & Serial -->
                    <div class="col-5">
                        <div class="p-2 border rounded" style="background-color: #fafafa; min-height: 120px;">
                            <div class="fw-bold text-uppercase border-bottom pb-1 mb-1" style="font-size: 11px; color: #374151;">
                                Certificate Reference (የደረሰኝ መለያ)
                            </div>
                            <div class="mb-1">
                                <strong>Receipt No (የደረሰኝ ቁ.):</strong><br/>
                                <span class="fs-5 fw-bold text-danger" t-esc="o.wht_receipt_number or 'DRAFT'"/>
                            </div>
                            <div t-if="o.wht_manual_receipt_number">
                                <strong>Booklet / Pad Serial No:</strong> <span class="fw-bold" t-field="o.wht_manual_receipt_number"/>
                            </div>
                            <div><strong>Date Issued (የተሰጠበት ቀን):</strong> <span t-esc="o.wht_receipt_date or o.invoice_date"/></div>
                            <div><strong>Vendor Bill Ref:</strong> <span t-esc="o.ref or o.name"/></div>
                        </div>
                    </div>
                </div>

                <!-- Middle Block: Payee (Vendor) Details -->
                <div class="card mb-3 border">
                    <div class="card-header py-1 px-2 bg-light fw-bold text-uppercase" style="font-size: 11px; color: #374151;">
                        Payee / Taxpayer Details (ተቀናሽ የተደረገበት ግብር ከፋይ / አቅራቢ)
                    </div>
                    <div class="card-body p-2">
                        <div class="row">
                            <div class="col-7">
                                <div><strong>Supplier Name (የአቅራቢው ስም):</strong> <span class="fw-bold" t-field="o.partner_id.name"/></div>
                                <div><strong>TIN (የግብር ከፋይ መለያ ቁጥር):</strong> <span class="font-monospace fw-bold fs-6" t-esc="o.partner_tin_number or 'N/A'"/></div>
                                <div t-if="o.partner_vat_reg_number">
                                    <strong>VAT Reg. No:</strong> <span t-field="o.partner_vat_reg_number"/>
                                </div>
                            </div>
                            <div class="col-5">
                                <div><strong>Address (አድራሻ):</strong></div>
                                <div>
                                    <span t-if="o.partner_sub_city">Sub-City: <span t-field="o.partner_sub_city"/>, </span>
                                    <span t-if="o.partner_woreda">Woreda: <span t-field="o.partner_woreda"/>, </span>
                                    <span t-if="o.partner_house_number">House No: <span t-field="o.partner_house_number"/></span>
                                </div>
                                <div t-if="o.partner_id.city"><span t-field="o.partner_id.city"/>, Ethiopia</div>
                                <div t-if="o.partner_id.phone">Phone: <span t-field="o.partner_id.phone"/></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Computation Details Table -->
                <div class="mb-3">
                    <table class="table table-sm table-bordered text-center align-middle" style="border-color: #cbd5e1;">
                        <thead style="background-color: #f1f5f9; font-size: 11px;">
                            <tr>
                                <th style="width: 30%;">Description / Nature of Supply<br/>(የእቃ / አገልግሎት መግለጫ)</th>
                                <th style="width: 15%;">Category<br/>(አይነት)</th>
                                <th style="width: 15%;">Invoice Untaxed Amount<br/>(ያልተጣራ ዋጋ)</th>
                                <th style="width: 10%;">WHT Rate<br/>(ምጣኔ)</th>
                                <th style="width: 15%;">Tax Withheld<br/>(የተቀነሰ ግብር)</th>
                                <th style="width: 15%;">Net Disbursed<br/>(የተጣራ ክፍያ)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-start">
                                    <span t-esc="o.invoice_line_ids and o.invoice_line_ids[0].name or 'Supply under Bill ' + (o.ref or o.name)"/>
                                    <t t-if="len(o.invoice_line_ids) &gt; 1">
                                        <div class="text-muted" style="font-size: 10px;">(+ <t t-esc="len(o.invoice_line_ids) - 1"/> additional line items)</div>
                                    </t>
                                </td>
                                <td>
                                    <span t-if="o.wht_type == 'goods'">Goods (እቃ)</span>
                                    <span t-elif="o.wht_type == 'services'">Services (አገልግሎት)</span>
                                    <span t-else="">Other</span>
                                </td>
                                <td class="text-end">
                                    <span t-esc="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                                <td>
                                    <span class="fw-bold" t-esc="o.wht_rate"/>%
                                </td>
                                <td class="text-end fw-bold" style="color: #b91c1c;">
                                    <span t-esc="o.wht_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                                <td class="text-end fw-bold" style="color: #047857;">
                                    <span t-esc="o.wht_net_payable" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot style="background-color: #f8fafc; font-weight: bold;">
                            <tr>
                                <td colspan="4" class="text-end text-uppercase" style="font-size: 11px;">Total Tax Withheld (ጠቅላላ የተቀነሰ ግብር):</td>
                                <td class="text-end fw-bold text-danger" style="font-size: 13px;">
                                    <span t-esc="o.wht_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                                <td class="text-end fw-bold text-success" style="font-size: 13px;">
                                    <span t-esc="o.wht_net_payable" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Amount in Words Block -->
                <div class="p-2 border rounded mb-3" style="background-color: #f8fafc;">
                    <div>
                        <strong>Amount Withheld in Words (AM / በፊደል):</strong>
                        <span class="fw-bold" style="color: #1e3a8a;" t-esc="o.wht_amount_words_am or 'ዜሮ ብር ብቻ'"/>
                    </div>
                    <div class="mt-1">
                        <strong>Amount Withheld in Words (EN):</strong>
                        <span class="fw-bold" style="color: #1e3a8a;" t-esc="o.wht_amount_words_en or 'Zero Birr Only'"/>
                    </div>
                </div>

                <!-- Legal Certification Notice -->
                <div class="p-2 border rounded mb-4" style="background-color: #fefce8; border-color: #fef08a; font-size: 11px; line-height: 1.4;">
                    <div class="fw-bold mb-1">LEGAL DECLARATION &amp; CERTIFICATION (ህጋዊ ማረጋገጫ):</div>
                    <p class="mb-1">
                        ይህ ደረሰኝ በገቢ ግብር አዋጅ ቁጥር 979/2016 እና አግባብነት ባላቸው ደንቦችና መመሪያዎች መሰረት ከክፍያ ላይ ተቀናሽ የተደረገውን ግብር የሚያረጋግጥ ህጋዊ ሰነድ ሲሆን፣ የተቆረጠው ግብር በህጉ በተወሰነው ጊዜ ውስጥ ለገቢዎች ሚኒስቴር ገቢ የሚደረግ መሆኑን እናረጋግጣለን።
                    </p>
                    <p class="mb-0 text-muted fst-italic">
                        We hereby certify that the tax indicated above has been lawfully withheld from the payment in accordance with Federal Income Tax Proclamation No. 979/2016 and will be duly remitted to the Ministry of Revenues within the statutory deadline.
                    </p>
                </div>

                <!-- Signatures & Stamp Block -->
                <div class="row pt-2 text-center" style="font-size: 11px;">
                    <div class="col-4">
                        <div class="border-top pt-2" style="margin-top: 45px; border-color: #94a3b8;">
                            <div class="fw-bold">Prepared By / ያዘጋጀው</div>
                            <div>Name: <span t-esc="o.create_uid.name or 'Accountant'"/></div>
                            <div>Date: <span t-esc="o.wht_receipt_date or o.invoice_date"/></div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border-top pt-2" style="margin-top: 45px; border-color: #94a3b8;">
                            <div class="fw-bold">Authorized Officer / ያረጋገጠው</div>
                            <div>Name: <span t-esc="o.wht_officer_name or o.company_id.et_wht_officer_name or 'Finance Manager'"/></div>
                            <div>Title: <span t-esc="o.company_id.et_wht_officer_title or 'Tax / Finance Officer'"/></div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded p-2" style="height: 95px; border-style: dashed !important; border-color: #94a3b8;">
                            <span class="text-muted fw-bold">Official Seal / Stamp<br/>(የድርጅቱ ማህተም)</span>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
