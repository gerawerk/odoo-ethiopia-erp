<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Partner Form View -->
    <record id="view_partner_form_inherit_l10n_et" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.l10n.et</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Tax Identification Fields -->
            <xpath expr="//field[@name='vat']" position="after">
                <field name="tin_number" placeholder="10 numeric digits"/>
                <field name="vat_reg_number" placeholder="e.g. 1234567890"/>
                <field name="is_withholding_agent"/>
                <field name="is_vat_registered"/>
            </xpath>

            <!-- Ethiopian Address Structure (Sub-City, Woreda, House No) -->
            <xpath expr="//div[hasclass('o_address_format')]" position="inside">
                <div class="d-flex gap-2 mt-1">
                    <field name="sub_city" placeholder="Sub-City (ክፍለ ከተማ)" class="o_address_city"/>
                    <field name="woreda" placeholder="Woreda (ወረዳ)" class="o_address_state"/>
                    <field name="house_number" placeholder="House No. (የቤት ቁጥር)" class="o_address_zip"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Inherit Partner List View -->
    <record id="view_partner_tree_inherit_l10n_et" model="ir.ui.view">
        <field name="name">res.partner.list.inherit.l10n.et</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="tin_number" optional="show"/>
                <field name="vat_reg_number" optional="hide"/>
                <field name="sub_city" optional="show"/>
                <field name="woreda" optional="hide"/>
                <field name="is_withholding_agent" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
